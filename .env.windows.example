SPP_ENVIRONMENT=PRODUCTION
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SPP_BOOTSTRAP_ADMIN_NAME=Production Administrator
SPP_BOOTSTRAP_ADMIN_PHONE=
SPP_BOOTSTRAP_ADMIN_GOVERNORATE=
